# ==============================================================================
# Enterprise Authentication System - Environment Variables Template
# Copy this file to '.env' and populate with secure values for your environment.
# NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth_db
POSTGRES_USER=auth_app
POSTGRES_PASSWORD=ChangeThisToASecurePasswordInProd!2026

# Database Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# Encryption & Master Secrets
# 256-bit (32 bytes) hex-encoded key for AES-256-GCM TOTP secret encryption at rest
APP_ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session & Security Settings
SESSION_TIMEOUT_MINUTES=15
COOKIE_SECURE=false

# Bootstrap Super Admin Credentials (One-time bootstrap only)
BOOTSTRAP_SUPERADMIN_ENABLED=true
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@enterprise.local
BOOTSTRAP_SUPERADMIN_PASSWORD=SuperAdmin#2026!ChangeMeNow
